{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas (fato_vendas)",
      "queryLines": [
        "SELECT ano, mes, CONCAT(ano, '-', LPAD(mes, 2, '0')) AS mes_referencia, ",
        "       data_pedido, canal, cliente_id, razao_social, segmento, cidade, ",
        "       vendedor_id, sku, categoria, marca, pedido_id, ",
        "       quantidade, receita, custo, margem, devolucao ",
        "FROM fato_vendas "
      ],
      "columns": [
        {
          "displayName": "Receita Total",
          "description": "Soma da receita l\u00edquida (com devolu\u00e7\u00e3o; pedidos cancelados j\u00e1 exclu\u00eddos na gold).",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Margem Total",
          "description": "Soma da margem (receita - custo).",
          "expression": "SUM(`margem`)"
        },
        {
          "displayName": "Pedidos",
          "description": "N\u00famero de pedidos distintos.",
          "expression": "COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Ticket Medio",
          "description": "Receita total dividida pelo n\u00famero de pedidos distintos.",
          "expression": "SUM(`receita`) / COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Margem Pct",
          "description": "Margem total dividida pela receita total (0-1, para format number-percent).",
          "expression": "SUM(`margem`) / SUM(`receita`)"
        }
      ]
    },
    {
      "name": "ds_top_clientes",
      "displayName": "Top 20 clientes",
      "queryLines": [
        "SELECT razao_social, segmento, cidade, SUM(receita) AS receita_cliente ",
        "FROM fato_vendas ",
        "GROUP BY razao_social, segmento, cidade ",
        "ORDER BY receita_cliente DESC ",
        "LIMIT 20"
      ]
    }
  ],
